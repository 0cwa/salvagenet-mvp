# Generated by install-usb-reconciler.sh from a non-secret USB identity file.
# This template is rendered only into /run/udev/rules.d by an active root
# session. It is never installed under /etc/udev/rules.d and never starts a
# service from udev. The event monitor is a separately started service.
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", KERNEL=="@USB_PHYSICAL_PORT@", ATTR{idVendor}=="@USB_VENDOR_ID@", ATTR{idProduct}=="@USB_PRODUCT_ID@", ATTR{serial}=="@USB_SERIAL@", TEST=="/run/salvagehost/nodehost-dev-usb.active", GROUP="@QEMU_GROUP@", MODE="0660"
