# Copy to .env and set only values specific to this workstation. The real file
# is ignored and is mounted into the guest; never commit credentials.
SALVAGEHOST_VM_NAME=salvagehost-dev
SALVAGEHOST_VM_MEMORY_MIB=16384
SALVAGEHOST_VM_VCPUS=12
SALVAGEHOST_VM_DISK_GIB=100
SALVAGEHOST_REPOSITORY=/var/home/x/Dev/salvagenet-mvp
SALVAGEHOST_SSH_PUBLIC_KEY=/var/home/x/.ssh/id_ed25519_tailnet.pub

# Leave empty for libvirt NAT only. Set this to the host's physical interface
# to add a best-effort direct macvtap NIC for phone-reachable lab services.
SALVAGEHOST_DIRECT_INTERFACE=

# Forward one TCP service from the host LAN to the guest's libvirt-NAT address.
# This is the reliable Wi-Fi fallback when a direct macvtap NIC cannot obtain a
# LAN lease. Leave SALVAGEHOST_LAN_FORWARD_PORT empty and do not run the
# forwarding helper to disable it. 8080 is the disposable local Headscale
# lab's documented control port.
SALVAGEHOST_LAN_INTERFACE=
SALVAGEHOST_LAN_FORWARD_PORT=8080
SALVAGEHOST_GUEST_FORWARD_PORT=8080
SALVAGEHOST_LIBVIRT_NETWORK=default

# By default the provisioner follows Ubuntu's current Noble cloud image and
# verifies it against the publisher's current SHA256SUMS manifest. Set both
# values below only when you deliberately want to retain a specific image.
SALVAGEHOST_UBUNTU_IMAGE_URL=
SALVAGEHOST_UBUNTU_IMAGE_SHA256=

# USB HIL identity is deliberately not stored here. Copy
# usb-device.conf.example to a non-secret host config and install it through
# install-usb-reconciler.sh. This .env may contain credentials.

# Agent tooling may source this file inside the guest. These values are never
# copied into cloud-init or libvirt metadata by the provisioner.
GITHUB_TOKEN=
OPENAI_API_KEY=
