{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodehost.example/schema/guest-bootstrap-secret-v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "mesh", "ssh", "callback"],
  "properties": {
    "apiVersion": {"const": "nodehost.example/v1alpha1"},
    "kind": {"const": "GuestBootstrapSecret"},
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlUrl", "oneUseAuthKey", "hostname"],
      "properties": {
        "controlUrl": {"type": "string", "pattern": "^https?://"},
        "oneUseAuthKey": {"type": "string", "minLength": 16},
        "hostname": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"}
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "emergencyAuthorizedKeys"],
      "properties": {
        "user": {"type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$"},
        "userCaPublicKey": {"type": ["string", "null"]},
        "emergencyAuthorizedKeys": {
          "type": "array",
          "items": {"type": "string", "pattern": "^ssh-(ed25519|rsa|ecdsa-[^ ]+) "},
          "uniqueItems": true
        }
      }
    },
    "callback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readyUrl", "capability"],
      "properties": {
        "readyUrl": {"type": "string", "pattern": "^http://10\\.0\\.2\\.2:[0-9]+/"},
        "capability": {"type": "string", "minLength": 16}
      }
    }
  }
}
