{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodehost.example/schema/guest-bootstrap-secret-v1alpha1.json",
  "title": "GuestBootstrapSecret",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "mesh", "ssh", "callback"],
  "properties": {
    "apiVersion": {"const": "nodehost.example/v1alpha1"},
    "kind": {"const": "GuestBootstrapSecret"},
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlUrl", "oneUseAuthKey", "hostname"],
      "properties": {
        "controlUrl": {"type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2048},
        "oneUseAuthKey": {"type": "string", "minLength": 16, "maxLength": 512},
        "hostname": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"}
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user"],
      "properties": {
        "user": {"type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$"},
        "userCaPublicKey": {"$ref": "#/$defs/sshPublicKey"},
        "emergencyAuthorizedKeys": {
          "type": "array", "maxItems": 4, "uniqueItems": true,
          "items": {"$ref": "#/$defs/sshPublicKey"}
        }
      },
      "oneOf": [
        {"required": ["userCaPublicKey"]},
        {
          "required": ["emergencyAuthorizedKeys"],
          "properties": {"emergencyAuthorizedKeys": {"minItems": 1}},
          "not": {"required": ["userCaPublicKey"]}
        }
      ]
    },
    "callback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readyUrl", "capability"],
      "properties": {
        "readyUrl": {"type": "string", "format": "uri", "pattern": "^http://10\\.0\\.2\\.2:[0-9]{1,5}/", "maxLength": 2048},
        "capability": {"type": "string", "minLength": 16, "maxLength": 512}
      }
    }
  },
  "$defs": {
    "sshPublicKey": {"type": "string", "minLength": 24, "maxLength": 16384, "pattern": "^ssh-(ed25519|rsa) [A-Za-z0-9+/=]+(?: .{1,128})?$"}
  }
}
