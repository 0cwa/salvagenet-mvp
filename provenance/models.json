      "AGENT_MODE": "goal",
      "AGENT_REASONING": "direct"
    },
    {
      "AGENT_MODEL": "human",
      "AGENT_RUN_ID": "review-2026-08-08",
      "AGENT_TASK_ID": "P01",
      "AGENT_MODE": "human-review",
      "AGENT_REASONING": "not-applicable"
    }
  ],
  "requiredTrailers": [
    "Agent-Model",
    "Agent-Run-ID",
    "Agent-Task-ID",
    "Agent-Mode",
    "Agent-Reasoning"
  ]
}
