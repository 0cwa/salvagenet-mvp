    },
    {
      "trailer": "Agent-Run-ID",
      "environment": "AGENT_RUN_ID"
    },
    {
      "trailer": "Agent-Task-ID",
      "environment": "AGENT_TASK_ID"
    },
    {
      "trailer": "Agent-Mode",
      "environment": "AGENT_MODE"
    },
    {
      "trailer": "Agent-Reasoning",
      "environment": "AGENT_REASONING"
    }
  ],
  "explicitUnavailableValues": [
    "unknown",
    "not-applicable"
  ],
  "examples": [
    {
      "AGENT_MODEL": "<exact-runtime-reported-model>",
      "AGENT_RUN_ID": "run-2026-08-08T120000Z",
