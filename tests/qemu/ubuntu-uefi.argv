# Normalized generic ARM64 UEFI argv compiled from the Ubuntu profile fixture.
${NATIVE_LIB}/libpodroid-launcher.so
${NATIVE_LIB}/libqemu-system-aarch64.so
-M
virt,gic-version=3
-cpu
max,pauth-impdef=on
-accel
tcg,thread=multi,tb-size=256
-smp
2
-m
1024
-drive
if=pflash,format=raw,readonly=on,file=${FILES}/vms/default/artifacts/AAVMF_CODE.fd
-drive
if=pflash,format=raw,file=${FILES}/vms/default/firmware-vars.fd
-smbios
type=1,serial=ds=nocloud-net;s=http://10.0.2.2:8080/v1/bootstrap/${TOKEN}/
-object
iothread,id=iothread0
-device
virtio-blk-pci,drive=system,num-queues=2,iothread=iothread0
-drive
file=${FILES}/vms/default/system.qcow2,if=none,id=system,format=qcow2,cache=writeback,aio=threads,discard=unmap,detect-zeroes=unmap
-object
iothread,id=iothread1
-device
virtio-blk-pci,drive=data,num-queues=2,iothread=iothread1
-drive
file=${FILES}/vms/default/data.raw,if=none,id=data,format=raw,cache=writeback,aio=threads,discard=unmap,detect-zeroes=unmap
-netdev
user,id=net0,ipv6=off,hostfwd=tcp:127.0.0.1:19922-:22
-device
virtio-net-pci,netdev=net0,romfile=
-serial
unix:${FILES}/vms/default/serial.sock,server,nowait
-device
virtio-serial-pci
-chardev
socket,id=term0,path=${FILES}/vms/default/terminal.sock,server=on,wait=off
-device
virtconsole,chardev=term0,name=org.podroid.term
-chardev
socket,id=ctrl0,path=${FILES}/vms/default/ctrl.sock,server=on,wait=off
-device
virtconsole,chardev=ctrl0,name=org.podroid.ctrl
-chardev
socket,id=host0,path=${FILES}/vms/default/host.sock,server=on,wait=off
-device
virtconsole,chardev=host0,name=org.podroid.host
-display
none
-qmp
unix:${FILES}/vms/default/qmp.sock,server,nowait
-cpu
max,sve=off,pauth-impdef=on
-accel
tcg,thread=multi,tb-size=512
-object
rng-random,id=rng0,filename=/dev/urandom
-device
virtio-rng-pci,rng=rng0
-overcommit
mem-lock=off
