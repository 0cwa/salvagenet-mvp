# Normalized knowledge fixture captured from the researched Podroid launch path.
${LAUNCHER}
${QEMU}
-M
virt,gic-version=3
-cpu
max,pauth-impdef=on
-accel
tcg,thread=multi,tb-size=${TB_SIZE_MB}
-smp
${VCPUS}
-m
${MEMORY_MIB}
-kernel
${FILES}/vmlinuz-virt
-append
console=ttyAMA0 mitigations=off androidip=${ANDROID_IP} ssh=1
-initrd
${FILES}/initrd.img
-object
iothread,id=iothread0
-device
virtio-blk-pci,drive=drive1,num-queues=${VCPUS},iothread=iothread0
-drive
file=${FILES}/storage.img,if=none,id=drive1,format=raw,cache=writeback,aio=threads,discard=unmap,detect-zeroes=unmap
-object
iothread,id=iothread1
-device
virtio-blk-pci,drive=drive2,num-queues=${VCPUS},iothread=iothread1
-drive
file=${FILES}/alpine-rootfs.squashfs,if=none,id=drive2,format=raw,readonly=on,cache=writeback,aio=threads
-netdev
user,id=net0,ipv6=off,hostfwd=tcp:127.0.0.1:${RECOVERY_PORT}-:22
-device
virtio-net-pci,netdev=net0,romfile=
-serial
unix:${INSTANCE}/serial.sock,server,nowait
-device
virtio-serial-pci
-chardev
socket,id=term0,path=${INSTANCE}/console.sock,server=on,wait=off
-device
virtconsole,chardev=term0,name=org.nodehost.console
-display
none
-qmp
unix:${INSTANCE}/qmp.sock,server,nowait
