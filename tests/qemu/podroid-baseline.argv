# Exact normalized argv emitted by pinned Podroid for the inputs in the metadata fixture.
# One argv element per line; ${NATIVE_LIB} and ${FILES} replace device-specific paths.
${NATIVE_LIB}/libpodroid-launcher.so
${NATIVE_LIB}/libqemu-system-aarch64.so
-M
virt,gic-version=3
-cpu
max,pauth-impdef=on
-accel
tcg,thread=multi,tb-size=256
-smp
2
-m
512
-kernel
${FILES}/vmlinuz-virt
-append
console=ttyAMA0 mitigations=off loglevel=1 quiet mitigations=off androidip=${ANDROID_IP} ssh=1 podroid.x11.dpi=96
-initrd
${FILES}/initrd.img
-object
iothread,id=iothread0
-device
virtio-blk-pci,drive=drive1,num-queues=2,iothread=iothread0
-drive
file=${FILES}/storage.img,if=none,id=drive1,format=raw,cache=writeback,aio=threads,discard=unmap,detect-zeroes=unmap
-object
iothread,id=iothread1
-device
virtio-blk-pci,drive=drive2,num-queues=2,iothread=iothread1
-drive
file=${FILES}/alpine-rootfs.squashfs,if=none,id=drive2,format=raw,readonly=on,cache=writeback,aio=threads
-netdev
user,id=net0,ipv6=off,hostfwd=tcp::9922-:22,hostfwd=tcp:127.0.0.1:5900-:5900,hostfwd=tcp:127.0.0.1:4713-:4713
-device
virtio-net-pci,netdev=net0,romfile=
-serial
unix:${FILES}/serial.sock,server,nowait
-device
virtio-serial-pci
-chardev
socket,id=term0,path=${FILES}/terminal.sock,server=on,wait=off
-device
virtconsole,chardev=term0,name=org.podroid.term
-chardev
socket,id=ctrl0,path=${FILES}/ctrl.sock,server=on,wait=off
-device
virtconsole,chardev=ctrl0,name=org.podroid.ctrl
-chardev
socket,id=host0,path=${FILES}/host.sock,server=on,wait=off
-device
virtconsole,chardev=host0,name=org.podroid.host
-display
none
-qmp
unix:${FILES}/qmp.sock,server,nowait
-cpu
max,sve=off,pauth-impdef=on
-accel
tcg,thread=multi,tb-size=512
-object
rng-random,id=rng0,filename=/dev/urandom
-device
virtio-rng-pci,rng=rng0
-overcommit
mem-lock=off
