{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodehost.example/schema/vm-profile-v1alpha1.json",
  "title": "VirtualMachineProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "nodehost.example/v1alpha1"},
    "kind": {"const": "VirtualMachineProfile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "derivedFrom": {"$ref": "#/$defs/id"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "machine", "boot", "systemDisk", "initialization", "network", "health", "requirements"],
      "properties": {
        "architecture": {"const": "aarch64"},
        "machine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "acceleration", "deviceTransport"],
          "properties": {
            "family": {"const": "virt"},
            "acceleration": {"const": "tcg"},
            "deviceTransport": {"const": "pci"},
            "cpuModel": {"type": "string", "pattern": "^[a-z0-9_-]{1,32}$"}
          }
        },
        "boot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"enum": ["direct-kernel", "uefi"]},
            "kernelArtifact": {"$ref": "#/$defs/artifactId"},
            "initramfsArtifact": {"$ref": "#/$defs/artifactId"},
            "firmwareCodeArtifact": {"$ref": "#/$defs/artifactId"},
            "firmwareVarsArtifact": {"$ref": "#/$defs/artifactId"},
            "kernelArgumentProfile": {"$ref": "#/$defs/id"}
          },
          "oneOf": [
            {
              "properties": {"type": {"const": "direct-kernel"}},
              "required": ["kernelArtifact", "initramfsArtifact", "kernelArgumentProfile"],
              "not": {"anyOf": [{"required": ["firmwareCodeArtifact"]}, {"required": ["firmwareVarsArtifact"]}]}
            },
            {
              "properties": {"type": {"const": "uefi"}},
              "required": ["firmwareCodeArtifact", "firmwareVarsArtifact"],
              "not": {"anyOf": [{"required": ["kernelArtifact"]}, {"required": ["initramfsArtifact"]}, {"required": ["kernelArgumentProfile"]}]}
            }
          ]
        },
        "systemDisk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "format", "writableLayer"],
          "properties": {
            "artifact": {"$ref": "#/$defs/artifactId"},
            "format": {"enum": ["raw", "qcow2", "squashfs"]},
            "writableLayer": {"enum": ["copied-writable", "separate-ext4-overlay", "none"]}
          }
        },
        "dataDisk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "defaultSizeGiB", "persistent"],
          "properties": {
            "format": {"const": "raw"},
            "defaultSizeGiB": {"type": "integer", "minimum": 1, "maximum": 1024},
            "persistent": {"type": "boolean"}
          }
        },
        "initialization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "vendorData"],
          "properties": {
            "type": {"enum": ["legacy-podroid", "nocloud-net"]},
            "vendorData": {"type": "string", "pattern": "^guest-init/[a-z0-9./_-]+$", "maxLength": 256},
            "metadataPath": {"type": "string", "pattern": "^/v1/bootstrap/\\{token\\}/$", "maxLength": 128}
          },
          "allOf": [
            {
              "if": {"properties": {"type": {"const": "nocloud-net"}}},
              "then": {"required": ["metadataPath"]},
              "else": {"not": {"required": ["metadataPath"]}}
            }
          ]
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "recoverySsh"],
          "properties": {
            "primary": {
              "type": "object", "additionalProperties": false, "required": ["type"],
              "properties": {"type": {"const": "slirp"}}
            },
            "recoverySsh": {
              "type": "object", "additionalProperties": false, "required": ["guestPort", "bind"],
              "properties": {"guestPort": {"const": 22}, "bind": {"const": "loopback"}}
            }
          }
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"enum": ["console-marker", "metadata-callback", "ssh"]},
            "marker": {"type": "string", "minLength": 1, "maxLength": 128}
          },
          "allOf": [
            {
              "if": {"properties": {"type": {"const": "console-marker"}}},
              "then": {"required": ["marker"]},
              "else": {"not": {"required": ["marker"]}}
            }
          ]
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumMemoryMiB", "minimumStorageGiB"],
          "properties": {
            "minimumMemoryMiB": {"type": "integer", "minimum": 256, "maximum": 16384},
            "minimumStorageGiB": {"type": "integer", "minimum": 1, "maximum": 1024},
            "qualificationChecks": {
              "type": "array", "maxItems": 32, "uniqueItems": true,
              "items": {"$ref": "#/$defs/id"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "artifactId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"}
  }
}
