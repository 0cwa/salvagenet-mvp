{
  "apiVersion": "nodehost.example/v1alpha1",
  "kind": "VirtualMachineProfile",
  "metadata": {
    "id": "k3s-worker-lab",
    "version": 1,
    "derivedFrom": "ubuntu-2404-arm64-uefi"
  },
  "spec": {
    "architecture": "aarch64",
    "machine": {
      "family": "virt",
      "acceleration": "tcg",
      "deviceTransport": "pci",
      "cpuModel": "max"
    },
    "boot": {
      "type": "uefi",
      "firmwareCodeArtifact": "aavmf-code",
      "firmwareVarsArtifact": "aavmf-vars"
    },
    "systemDisk": {
      "artifact": "ubuntu-2404-arm64-cloud",
      "format": "qcow2",
      "writableLayer": "copied-writable"
    },
    "dataDisk": {
      "format": "raw",
      "defaultSizeGiB": 8,
      "persistent": true
    },
    "initialization": {
      "type": "nocloud-net",
      "vendorData": "guest-init/k3s-worker-lab/vendor-data.yaml",
      "metadataPath": "/v1/bootstrap/{token}/"
    },
    "network": {
      "primary": {
        "type": "slirp"
      },
      "recoverySsh": {
        "guestPort": 22,
        "bind": "loopback"
      }
    },
    "health": {
      "type": "metadata-callback"
    },
    "requirements": {
      "minimumMemoryMiB": 1024,
      "minimumStorageGiB": 8,
      "qualificationChecks": [
        "cgroup-v2",
        "namespaces",
        "overlayfs",
        "br-netfilter",
        "vxlan",
        "tun",
        "iptables-or-nft",
        "ip-forwarding",
        "swap-policy",
        "minimum-memory",
        "minimum-storage",
        "tailscale-reachability"
      ]
    }
  }
}
