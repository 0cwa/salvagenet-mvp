{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salvage.network/schemas/roadmap.snapshot.v1.schema.json",
  "title": "SalvageNet public roadmap snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "source",
    "milestones",
    "items",
    "disagreements"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "milestones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/milestone"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "sourceHash",
        "newestIssueUpdate",
        "fallback"
      ],
      "properties": {
        "repository": {
          "const": "0cwa/salvagenet-mvp"
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "newestIssueUpdate": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "fallback": {
          "type": "boolean"
        },
        "fallbackReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "snapshotAgeSeconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "fallback": {
                "const": true
              }
            },
            "required": ["fallback"]
          },
          "then": {
            "required": ["fallbackReason"]
          }
        }
      ]
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title", "description", "state"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "state": {
          "enum": ["open", "closed"]
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[BU][0-9]{2}$"
        },
        "status": {
          "type": "string",
          "pattern": "^[A-Z][A-Z-]*$"
        }
      }
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "state",
        "draft",
        "merged",
        "mergedAt",
        "url",
        "headSha"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "draft": {
          "type": ["boolean", "null"]
        },
        "merged": {
          "type": ["boolean", "null"]
        },
        "mergedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "headSha": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "title",
        "summary",
        "url",
        "milestone",
        "area",
        "kind",
        "public",
        "workState",
        "dependencyState",
        "blockedBy",
        "taskPacket",
        "taskAuthorized",
        "acceptance",
        "updatedAt",
        "pullRequests"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2}$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "milestone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "area": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "public": {
          "type": "boolean"
        },
        "workState": {
          "enum": [
            "done",
            "review",
            "active",
            "ready",
            "queued",
            "hold",
            "planned"
          ]
        },
        "dependencyState": {
          "enum": ["clear", "blocked"]
        },
        "blockedBy": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2}$"
          }
        },
        "taskPacket": {
          "type": ["string", "null"],
          "pattern": "^[^/].*$"
        },
        "taskAuthorized": {
          "type": "boolean"
        },
        "acceptance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptance"
          }
        },
        "updatedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "pullRequests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pullRequest"
          }
        }
      }
    }
  }
}
