---
/* Small geometric line icons in the board's bold-line style.
   Stroke icons inherit currentColor; the github mark is filled. */
interface Props {
  name: keyof typeof icons;
  label?: string;
}

const icons = {
  code: '<polyline points="8 7 3 12 8 17"/><polyline points="16 7 21 12 16 17"/><line x1="13.5" y1="5" x2="10.5" y2="19"/>',
  lock: '<rect x="5" y="10.5" width="14" height="9" rx="2"/><path d="M8 10.5V7.8a4 4 0 0 1 8 0v2.7"/><circle cx="12" cy="15" r="1.3"/>',
  'shield-check':
    '<path d="M12 3.5 5 6v5.2c0 4.3 2.9 7.4 7 9.3 4.1-1.9 7-5 7-9.3V6z"/><polyline points="9.2 11.8 11.2 13.8 14.9 10"/>',
  sprout:
    '<path d="M12 20.5v-8"/><path d="M12 12.5C12 8.9 9.1 6 5.5 6H4v.5C4 10.1 6.9 13 10.5 13H12z"/><path d="M12 11c0-3 2.4-5.5 5.5-5.5H19v.5c0 3.6-2.9 6.5-6.5 6.5H12z"/>',
  phone:
    '<rect x="7" y="3" width="10" height="18" rx="2.5"/><line x1="10.5" y1="17.5" x2="13.5" y2="17.5"/>',
  server:
    '<rect x="4" y="4" width="16" height="6.4" rx="1.6"/><rect x="4" y="13.6" width="16" height="6.4" rx="1.6"/><line x1="7.4" y1="7.2" x2="7.4" y2="7.21"/><line x1="7.4" y1="16.8" x2="7.4" y2="16.81"/>',
  boxes:
    '<path d="M12 3.5 4.8 7.6v8.2L12 20.5l7.2-4.7V7.6z"/><path d="M12 12 4.8 7.6M12 12l7.2-4.4M12 12v8.5"/>',
  leaf:
    '<path d="M5.5 18.5C5.5 10.5 11 5 19.5 5c0 9-5.5 14-13 13.5"/><path d="M5.5 18.5C8 13.5 11.5 10 16 8"/>',
  puzzle:
    '<path d="M9.5 4.5h5v3.2a1.9 1.9 0 1 0 3 0V4.5h2v5h-3.2a1.9 1.9 0 1 0 0 3h3.2v7h-10z"/>',
  eye: '<path d="M2.5 12S6 5.8 12 5.8 21.5 12 21.5 12 18 18.2 12 18.2 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="2.8"/>',
  'arrow-right': '<line x1="3.5" y1="12" x2="20" y2="12"/><polyline points="13.5 5.5 20 12 13.5 18.5"/>',
  check: '<polyline points="4.5 12.5 9.5 17.5 19.5 6.5"/>',
  sun: '<circle cx="12" cy="12" r="4"/><line x1="12" y1="2.5" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="21.5"/><line x1="2.5" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="21.5" y2="12"/><line x1="5.3" y1="5.3" x2="7" y2="7"/><line x1="17" y1="17" x2="18.7" y2="18.7"/><line x1="5.3" y1="18.7" x2="7" y2="17"/><line x1="17" y1="7" x2="18.7" y2="5.3"/>',
  moon: '<path d="M20 13.5A8 8 0 0 1 10.5 4 8 8 0 1 0 20 13.5z"/>',
  github:
    '<path d="M12 .8C5.7.8.7 5.9.7 12.2c0 5 3.2 9.3 7.7 10.8.6.1.8-.2.8-.5v-2c-3.1.7-3.8-1.3-3.8-1.3-.5-1.3-1.2-1.7-1.2-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.2 1.7 1.2 1 1.7 2.6 1.2 3.2.9.1-.7.4-1.2.7-1.5-2.5-.3-5.1-1.3-5.1-5.6 0-1.2.4-2.2 1.1-3-.1-.3-.5-1.4.1-3 0 0 .9-.3 3.1 1.2a10.7 10.7 0 0 1 5.6 0c2.2-1.5 3.1-1.2 3.1-1.2.6 1.6.2 2.7.1 3 .7.8 1.1 1.8 1.1 3 0 4.3-2.6 5.3-5.1 5.6.4.3.8 1 .8 2.1v3.1c0 .3.2.6.8.5a11.4 11.4 0 0 0 7.7-10.8C23.3 5.9 18.3.8 12 .8z"/>',
} as const;

const { name, label } = Astro.props;
const filled = name === 'github';
---

<svg
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
>
  <Fragment set:html={icons[name]} />
</svg>
