---
/* Decorative circuit frame echoing the approved board border.
   It follows the full document rather than obscuring scrolling content. */
---

<div class="page-frame" aria-hidden="true"></div>
<div class="frame-nodes" aria-hidden="true">
  <span class="fj" style="top:calc(var(--frame-inset) - 5px);left:20%"></span>
  <span class="fj" style="top:calc(var(--frame-inset) - 5px);left:52%"></span>
  <span class="fj" style="top:calc(var(--frame-inset) - 5px);right:16%"></span>
  <span class="fj" style="bottom:calc(var(--frame-inset) - 5px);left:26%"></span>
  <span class="fj" style="bottom:calc(var(--frame-inset) - 5px);left:58%"></span>
  <span class="fj" style="bottom:calc(var(--frame-inset) - 5px);right:22%"></span>
  <span class="fj" style="left:calc(var(--frame-inset) - 5px);top:32%"></span>
  <span class="fj" style="left:calc(var(--frame-inset) - 5px);top:68%"></span>
  <span class="fj" style="right:calc(var(--frame-inset) - 5px);top:38%"></span>
  <span class="fj" style="right:calc(var(--frame-inset) - 5px);top:64%"></span>
  <span class="fd fd--amber" style="top:calc(var(--frame-inset) - 3px);left:36%"></span>
  <span class="fd fd--copper" style="right:calc(var(--frame-inset) - 3px);top:22%"></span>
  <span class="fd fd--amber" style="bottom:calc(var(--frame-inset) - 3px);right:40%"></span>
</div>

<style>
  .frame-nodes {
    position: absolute;
    inset: 0;
    z-index: 41;
    pointer-events: none;
  }
  .fj,
  .fd {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .fj {
    width: 11px;
    height: 11px;
    background: var(--canvas);
    border: 2px solid var(--ink);
  }
  .fd {
    width: 7px;
    height: 7px;
  }
  .fd--amber {
    background: var(--amber);
  }
  .fd--copper {
    background: var(--copper);
  }
  @media (max-width: 720px) {
    .fj,
    .fd {
      display: none;
    }
  }
</style>
