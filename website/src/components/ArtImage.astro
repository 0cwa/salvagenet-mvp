---
/* Theme-aware artwork with optional mobile-focused crops. */
interface MobileSource {
  width: number;
  height: number;
}

interface Props {
  name: string;
  alt: string;
  width: number;
  height: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  mobile?: MobileSource;
}

const {
  name,
  alt,
  width,
  height,
  class: klass,
  loading = 'lazy',
  mobile,
} = Astro.props;
---

<picture class:list={['art', klass]}>
  {mobile && (
    <source
      media="(max-width: 600px)"
      srcset={`/assets/art-${name}-mobile-dark.webp`}
      width={mobile.width}
      height={mobile.height}
    />
  )}
  <img
    src={`/assets/art-${name}-dark.webp`}
    width={width}
    height={height}
    alt={alt}
    loading={loading}
  />
</picture>
