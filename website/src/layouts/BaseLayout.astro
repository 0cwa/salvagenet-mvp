---
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/global.css';

import PageFrame from '../components/PageFrame.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  current: '/' | '/status' | '/roadmap' | '/about';
}

const { title, description, current } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#F7F4EE" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#02232B" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        try {
          const key = 'salvagenet.theme';
          const saved = localStorage.getItem(key) ?? localStorage.getItem('sn-theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
            localStorage.setItem(key, saved);
          }
          localStorage.removeItem('sn-theme');
        } catch (e) {}
      })();
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SalvageNet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/assets/hero-illustration.png', Astro.site)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <PageFrame />
    <SiteHeader current={current} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <script is:inline>
      (() => {
        const controls = [...document.querySelectorAll('.theme-control')];
        if (!controls.length) return;
        const key = 'salvagenet.theme';
        const root = document.documentElement;
        const systemQuery = matchMedia('(prefers-color-scheme: dark)');
        const selected = () => root.dataset.theme ?? 'system';
        const sync = () => {
          controls.forEach((control) => {
            if (control instanceof HTMLElement) control.hidden = false;
            control.querySelectorAll('[data-theme-choice]').forEach((button) => {
              button.setAttribute('aria-pressed', String(button.getAttribute('data-theme-choice') === selected()));
            });
          });
        };
        controls.forEach((control) => {
          control.addEventListener('click', (event) => {
            const button = event.target instanceof Element
              ? event.target.closest('[data-theme-choice]')
              : null;
            if (!(button instanceof HTMLButtonElement)) return;
            const choice = button.dataset.themeChoice;
            if (choice === 'light' || choice === 'dark') {
              root.dataset.theme = choice;
              try { localStorage.setItem(key, choice); } catch (e) {}
            } else {
              delete root.dataset.theme;
              try { localStorage.removeItem(key); } catch (e) {}
            }
            sync();
          });
        });
        systemQuery.addEventListener('change', sync);
        sync();
      })();
    </script>
  </body>
</html>
